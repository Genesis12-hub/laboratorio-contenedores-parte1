# Copiar este archivo a infra/.env y sustituir el marcador.
# La sustitución es obligatoria: el marcador no es una contraseña de uso.
# No recuperar ni reutilizar la contraseña que apareció en la demostración del docente.
# infra/.env permanece fuera de Git.
POSTGRES_PASSWORD=REEMPLAZAR_CON_CONTRASENA_LOCAL
